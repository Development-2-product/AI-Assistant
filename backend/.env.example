# ---- Gemini ----
# Use a PAID-tier key. Free-tier prompts may be used by Google to improve its products,
# which is not acceptable for private WhatsApp/Gmail content.
GEMINI_API_KEY=your-gemini-api-key
# Fast model: classifies every message (language, tone, risk, conversation state)
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# Writer model: writes replies, missed-call messages and recaps
GEMINI_MODEL_WRITER=gemini-3.5-flash
# Tried automatically when a model is overloaded (503) or rate-limited (429). Empty = use the other model above.
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=12

# ---- Auth ----
# "firebase" in production (verifies Firebase ID tokens from the app)
# "dev" for local testing (accepts DEV_API_TOKEN as a bearer token)
AUTH_MODE=dev
# Required only when AUTH_MODE=dev. Generate a long random value locally; never commit it.
DEV_API_TOKEN=
# Your Firebase project ID (Firebase console > Project settings). Needed when AUTH_MODE=firebase.
FIREBASE_PROJECT_ID=
# Optional comma-separated browser origins. Leave blank for the Android app.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
CORS_ALLOWED_ORIGINS=

# ---- Limits ----
RATE_LIMIT_PER_MINUTE=60
# Optional. Set in production so limits are shared across Cloud Run instances.
REDIS_URL=

ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Local Docker Compose only ----
# Safe by default: API is reachable only from this computer. For a phone on the same trusted Wi-Fi,
# set BIND_ADDRESS=0.0.0.0 and keep HOST_PORT=8000 in the real ignored backend/.env.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000
